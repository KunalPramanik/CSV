# Network Port
PORT=4000

# Environment Mode
NODE_ENV=development

# OpenAI API Key (Required for Structured Outputs Mapping)
OPENAI_API_KEY=your_openai_api_key_here

# Allowed CORS client domain (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Max allowed multipart file upload size in Megabytes
MAX_FILE_SIZE_MB=10

# Size of batch processed per single LLM chat completion call
DEFAULT_BATCH_SIZE=20
